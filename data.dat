# For model.mod ONLY (stacked KKT MCP / PATH). Matches iso_market/node_network.py.
# For hub-spoke nash_cournot.mod / monopoly.mod use cournot_data.dat instead.

set NODES := 1 2 3 4 5;
set FIRMS := F1 F2;
set PLANTS := F1 1  F1 2  F2 2;

# Transmission links: 1:(1-2), 2:(2-3), 3:(3-1), 4:(3-4), 5:(4-5)
set LINKS := 1 2 3 4 5;

param line_name :=
1 '1-2'  2 '2-3'  3 '3-1'  4 '3-4'  5 '4-5';

param P0 :=
1 55
2 50
3 75
4 70
5 70;

param Q0 :=
1 250
2 200
3 25
4 20
5 15;

param MC :=
F1 1 18
F1 2 18
F2 2 22;

param QC :=
F1 1 0.04
F1 2 0.04
F2 2 0.02;

param CAP :=
F1 1 150
F1 2 50
F2 2 100;

param T :=
1 40
2 15
3 25
4 20
5 10;

# PTDF: reference node 5. Lines: 1-2, 2-3, 3-1, 3-4, 4-5
param PTDF :
   1      2      3      4      5 :=
1  0.3333 -0.3333  0      0      0
2  0.3333  0.6667  0      0      0
3 -0.6667 -0.3333  0      0      0
4  1      1      1      0      0
5  1      1      1      1      0;
